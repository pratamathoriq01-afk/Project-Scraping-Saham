# Copy to frontend/.env.local and fill with your Supabase project credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# FastAPI Backend URL for Next.js /api/:path* proxy rewrite (defaults to http://127.0.0.1:8000 locally)
BACKEND_API_URL=http://127.0.0.1:8000

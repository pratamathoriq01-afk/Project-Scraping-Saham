# Supabase Backend Credentials (copy to backend/.env and fill locally; NEVER commit .env)
SUPABASE_URL=https://your-project-ref.supabase.co

# Public read key (supports either new Publishable Key or legacy Anon Key)
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=

# Backend write key (supports either new Secret Key sb_secret_... or legacy Service Role Key)
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
